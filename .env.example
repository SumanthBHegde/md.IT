# Copy to .env to override the development defaults in docker-compose.yml.
# MySQL only reads DB_* when its volume is first created; after changing them run
# `docker compose down -v` (this deletes local server data).
DB_NAME=mdit
DB_USER=mdit
DB_PASSWORD=mdit-dev-password
BLOB_CONTAINER=mdit-blobs
LOG_LEVEL=INFO
# Defaults to Azurite's development account at http://azurite:10000.
# BLOB_CONNECTION_STRING=
# Host port for MySQL; 3307 because a local MySQL often holds 3306 (P-055).
MYSQL_PORT=3307
GATEWAY_PORT=8080

# Sign-in (Phase 5a). Development only: generate your own SESSION_SECRET (32+ characters,
# e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`) for any shared
# deployment, and never enable DEV_LOGIN there.
PUBLIC_BASE_URL=http://localhost:8080
SESSION_SECRET=mdit-dev-session-secret-change-me-0000
SESSION_DAYS=30
COOKIE_SECURE=true
DEV_LOGIN=1
# OAuth apps (optional). Both values of a pair enable that provider; see README "Sign-in".
# Callback URLs: http://localhost:8080/api/auth/callback/github and …/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
